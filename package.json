{
  "name": "agent-tren",
  "productName": "Agent Tren",
  "version": "1.1.0",
  "description": "A little widget that keeps an eye on your Claude Code sessions",
  "author": "Jure M",
  "license": "MIT",
  "homepage": "https://github.com/JureM-student/agent-tren",
  "repository": {
    "type": "git",
    "url": "https://github.com/JureM-student/agent-tren.git"
  },
  "bugs": {
    "url": "https://github.com/JureM-student/agent-tren/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "electron",
    "widget",
    "ai-agents",
    "developer-tools"
  ],
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jurematis.agenttren",
    "productName": "Agent Tren",
    "copyright": "Copyright © 2026 Jure M",
    "files": [
      "main.js",
      "preload.js",
      "claude-settings.js",
      "index.html",
      "build/icon.png",
      "build/tray.png",
      "build/tray@2x.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Agent-Tren-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Tren",
      "uninstallDisplayName": "Agent Tren",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
